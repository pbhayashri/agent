<?xml version="1.0" encoding="utf-8"?>
<policyDefinitions xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" revision="1.3" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <policyNamespaces>
    <target prefix="AssetSync-Agent" namespace="AssetSync-Agent" />
    <using prefix="windows" namespace="Microsoft.Policies.Windows" />
  </policyNamespaces>
  <resources minRequiredRevision="1.3" />
  <categories>
    <category name="AssetSync_ROOT" displayName="$(string.AssetSync_ROOT)">
      <parentCategory ref="windows:System" />
    </category>
  </categories>
  <policies>
    <policy name="AssetSync_CONFIGURE" class="Machine" displayName="$(string.AssetSync_CONFIGURE)" explainText="$(string.AssetSync_CONFIGURE_EXPLAIN)" presentation="$(presentation.AssetSync_CONFIGURE)" key="SOFTWARE\AssetSync-Agent">
      <parentCategory ref="AssetSync_ROOT" />
      <supportedOn ref="windows:SUPPORTED_WindowsXP" />
      <elements>
        <text id="AssetSync_Server" key="SOFTWARE\AssetSync-Agent" valueName="server" required="true" />
        <text id="AssetSync_Proxy" key="SOFTWARE\AssetSync-Agent" valueName="proxy" />
        <text id="AssetSync_User" key="SOFTWARE\AssetSync-Agent" valueName="user" />
        <text id="AssetSync_Password" key="SOFTWARE\AssetSync-Agent" valueName="password" />
        <text id="AssetSync_Tag" key="SOFTWARE\AssetSync-Agent" valueName="tag" />
        <text id="AssetSync_ca-cert-dir" key="SOFTWARE\AssetSync-Agent" valueName="ca-cert-dir" />
        <text id="AssetSync_ca-cert-file" key="SOFTWARE\AssetSync-Agent" valueName="ca-cert-file" />
        <text id="AssetSync_ssl-fingerprint" key="SOFTWARE\AssetSync-Agent" valueName="ssl-fingerprint" />
        <text id="AssetSync_httpd-ip" key="SOFTWARE\AssetSync-Agent" valueName="httpd-ip" />
        <text id="AssetSync_httpd-port" key="SOFTWARE\AssetSync-Agent" valueName="httpd-port" required="true" />
        <text id="AssetSync_httpd-trust" key="SOFTWARE\AssetSync-Agent" valueName="httpd-trust" required="true" />
        <text id="AssetSync_no-category" key="SOFTWARE\AssetSync-Agent" valueName="no-category" />
        <text id="AssetSync_no-task" key="SOFTWARE\AssetSync-Agent" valueName="no-task" />
        <text id="AssetSync_tasks" key="SOFTWARE\AssetSync-Agent" valueName="tasks" />
        <text id="AssetSync_delaytime" key="SOFTWARE\AssetSync-Agent" valueName="delaytime" required="true" />
        <text id="AssetSync_timeout" key="SOFTWARE\AssetSync-Agent" valueName="timeout" required="true" />
        <text id="AssetSync_backend-collect-timeout" key="SOFTWARE\AssetSync-Agent" valueName="backend-collect-timeout" required="true" />
        <text id="AssetSync_debug" key="SOFTWARE\AssetSync-Agent" valueName="debug" required="true" />
        <boolean id="AssetSync_no-ssl-check" key="SOFTWARE\AssetSync-Agent" valueName="no-ssl-check">
          <trueValue>
            <string>1</string>
          </trueValue>
          <falseValue>
            <string>0</string>
          </falseValue>
        </boolean>
        <boolean id="AssetSync_no-p2p" key="SOFTWARE\AssetSync-Agent" valueName="no-p2p">
          <trueValue>
            <string>1</string>
          </trueValue>
          <falseValue>
            <string>0</string>
          </falseValue>
        </boolean>
        <boolean id="AssetSync_scan-homedirs" key="SOFTWARE\AssetSync-Agent" valueName="scan-homedirs">
          <trueValue>
            <string>1</string>
          </trueValue>
          <falseValue>
            <string>0</string>
          </falseValue>
        </boolean>
        <boolean id="AssetSync_scan-profiles" key="SOFTWARE\AssetSync-Agent" valueName="scan-profiles">
          <trueValue>
            <string>1</string>
          </trueValue>
          <falseValue>
            <string>0</string>
          </falseValue>
        </boolean>
        <boolean id="AssetSync_no-httpd" key="SOFTWARE\AssetSync-Agent" valueName="no-httpd">
          <trueValue>
            <string>1</string>
          </trueValue>
          <falseValue>
            <string>0</string>
          </falseValue>
        </boolean>
        <text id="AssetSync_full-inventory-postpone" key="SOFTWARE\AssetSync-Agent" valueName="full-inventory-postpone" required="true" />
        <text id="AssetSync_required-category" key="SOFTWARE\AssetSync-Agent" valueName="required-category" />
        <text id="AssetSync_itemtype" key="SOFTWARE\AssetSync-Agent" valueName="itemtype" />
        <boolean id="AssetSync_json" key="SOFTWARE\AssetSync-Agent" valueName="json">
          <trueValue>
            <string>1</string>
          </trueValue>
          <falseValue>
            <string>0</string>
          </falseValue>
        </boolean>
      </elements>
    </policy>
    <policy name="AssetSync_CONFIGURE32on64" class="Machine" displayName="$(string.AssetSync_CONFIGURE32on64)" explainText="$(string.AssetSync_CONFIGURE_EXPLAIN)" presentation="$(presentation.AssetSync_CONFIGURE)" key="SOFTWARE\Wow6432Node\AssetSync-Agent">
      <parentCategory ref="AssetSync_ROOT" />
      <supportedOn ref="windows:SUPPORTED_WindowsXP" />
      <elements>
        <text id="AssetSync_Server" key="SOFTWARE\Wow6432Node\AssetSync-Agent" valueName="server" required="true" />
        <text id="AssetSync_Proxy" key="SOFTWARE\Wow6432Node\AssetSync-Agent" valueName="proxy" />
        <text id="AssetSync_User" key="SOFTWARE\Wow6432Node\AssetSync-Agent" valueName="user" />
        <text id="AssetSync_Password" key="SOFTWARE\Wow6432Node\AssetSync-Agent" valueName="password" />
        <text id="AssetSync_Tag" key="SOFTWARE\Wow6432Node\AssetSync-Agent" valueName="tag" />
        <text id="AssetSync_ca-cert-dir" key="SOFTWARE\Wow6432Node\AssetSync-Agent" valueName="ca-cert-dir" />
        <text id="AssetSync_ca-cert-file" key="SOFTWARE\Wow6432Node\AssetSync-Agent" valueName="ca-cert-file" />
        <text id="AssetSync_ssl-fingerprint" key="SOFTWARE\Wow6432Node\AssetSync-Agent" valueName="ssl-fingerprint" />
        <text id="AssetSync_httpd-ip" key="SOFTWARE\Wow6432Node\AssetSync-Agent" valueName="httpd-ip" defaultValue="0.0.0.0" />
        <text id="AssetSync_httpd-port" key="SOFTWARE\Wow6432Node\AssetSync-Agent" valueName="httpd-port" required="true" />
        <text id="AssetSync_httpd-trust" key="SOFTWARE\Wow6432Node\AssetSync-Agent" valueName="httpd-trust" required="true" />
        <text id="AssetSync_no-category" key="SOFTWARE\Wow6432Node\AssetSync-Agent" valueName="no-category" />
        <text id="AssetSync_no-task" key="SOFTWARE\Wow6432Node\AssetSync-Agent" valueName="no-task" />
        <text id="AssetSync_tasks" key="SOFTWARE\Wow6432Node\AssetSync-Agent" valueName="tasks" />
        <text id="AssetSync_delaytime" key="SOFTWARE\Wow6432Node\AssetSync-Agent" valueName="delaytime" required="true" />
        <text id="AssetSync_timeout" key="SOFTWARE\Wow6432Node\AssetSync-Agent" valueName="timeout" required="true" />
        <text id="AssetSync_backend-collect-timeout" key="SOFTWARE\Wow6432Node\AssetSync-Agent" valueName="backend-collect-timeout" required="true" />
        <text id="AssetSync_debug" key="SOFTWARE\Wow6432Node\AssetSync-Agent" valueName="debug" required="true" />
        <boolean id="AssetSync_no-ssl-check" key="SOFTWARE\Wow6432Node\AssetSync-Agent" valueName="no-ssl-check">
          <trueValue>
            <decimal value="1" />
          </trueValue>
          <falseValue>
            <decimal value="0" />
          </falseValue>
        </boolean>
        <boolean id="AssetSync_no-p2p" key="SOFTWARE\Wow6432Node\AssetSync-Agent" valueName="no-p2p">
          <trueValue>
            <string>1</string>
          </trueValue>
          <falseValue>
            <string>0</string>
          </falseValue>
        </boolean>
        <boolean id="AssetSync_scan-homedirs" key="SOFTWARE\Wow6432Node\AssetSync-Agent" valueName="scan-homedirs">
          <trueValue>
            <string>1</string>
          </trueValue>
          <falseValue>
            <string>0</string>
          </falseValue>
        </boolean>
        <boolean id="AssetSync_scan-profiles" key="SOFTWARE\Wow6432Node\AssetSync-Agent" valueName="scan-profiles">
          <trueValue>
            <string>1</string>
          </trueValue>
          <falseValue>
            <string>0</string>
          </falseValue>
        </boolean>
        <boolean id="AssetSync_no-httpd" key="SOFTWARE\Wow6432Node\AssetSync-Agent" valueName="no-httpd">
          <trueValue>
            <string>1</string>
          </trueValue>
          <falseValue>
            <string>0</string>
          </falseValue>
        </boolean>
        <text id="AssetSync_full-inventory-postpone" key="SOFTWARE\Wow6432Node\AssetSync-Agent" valueName="full-inventory-postpone" required="true" />
        <text id="AssetSync_required-category" key="SOFTWARE\Wow6432Node\AssetSync-Agent" valueName="required-category" />
        <text id="AssetSync_itemtype" key="SOFTWARE\Wow6432Node\AssetSync-Agent" valueName="itemtype" />
        <boolean id="AssetSync_json" key="SOFTWARE\Wow6432Node\AssetSync-Agent" valueName="json">
          <trueValue>
            <string>1</string>
          </trueValue>
          <falseValue>
            <string>0</string>
          </falseValue>
        </boolean>
      </elements>
    </policy>
  </policies>
</policyDefinitions>
