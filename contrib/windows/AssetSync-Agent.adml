<?xml version="1.0" encoding="utf-8"?>
<policyDefinitionResources xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" revision="1.3" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <displayName>AssetSync Agent GPO configuration</displayName>
  <description>AssetSync Agent GPO configuration</description>
  <resources>
    <stringTable>
      <string id="AssetSync_ROOT">AssetSync Agent</string>
      <string id="AssetSync_CONFIGURE32on64">Configure the 32-bit agent on 64 bit computers</string>
      <string id="AssetSync_CONFIGURE">Configure the agent</string>
      <string id="AssetSync_CONFIGURE_EXPLAIN">Specify the paramaters for AssetSync Agent.</string>
    </stringTable>
    <presentationTable>
      <presentation id="AssetSync_CONFIGURE">
        <textBox refId="AssetSync_Server">
          <label>Server</label>
          <defaultValue></defaultValue>
        </textBox>
        <textBox refId="AssetSync_Proxy">
          <label>Proxy server</label>
          <defaultValue></defaultValue>
        </textBox>
        <textBox refId="AssetSync_User">
          <label>Proxy User</label>
          <defaultValue></defaultValue>
        </textBox>
        <textBox refId="AssetSync_Password">
          <label>Proxy Password</label>
          <defaultValue></defaultValue>
        </textBox>
        <textBox refId="AssetSync_Tag">
          <label>Tag</label>
          <defaultValue></defaultValue>
        </textBox>
        <textBox refId="AssetSync_ca-cert-dir">
          <label>CA-cert-dir</label>
          <defaultValue></defaultValue>
        </textBox>
        <textBox refId="AssetSync_ca-cert-file">
          <label>CA-cert-file</label>
          <defaultValue></defaultValue>
        </textBox>
        <textBox refId="AssetSync_ssl-fingerprint">
          <label>ssl-fingerprint</label>
          <defaultValue></defaultValue>
        </textBox>
        <textBox refId="AssetSync_httpd-ip">
          <label>httpd-ip</label>
          <defaultValue>0.0.0.0</defaultValue>
        </textBox>
        <textBox refId="AssetSync_httpd-port">
          <label>httpd-port</label>
          <defaultValue>62354</defaultValue>
        </textBox>
        <textBox refId="AssetSync_httpd-trust">
          <label>httpd-trust</label>
          <defaultValue>127.0.0.1/32</defaultValue>
        </textBox>
        <textBox refId="AssetSync_no-category">
          <label>no-category</label>
          <defaultValue></defaultValue>
        </textBox>
        <textBox refId="AssetSync_no-task">
          <label>no-task</label>
          <defaultValue></defaultValue>
        </textBox>
        <textBox refId="AssetSync_tasks">
          <label>tasks</label>
          <defaultValue></defaultValue>
        </textBox>
        <textBox refId="AssetSync_delaytime">
          <label>Delaytime</label>
          <defaultValue>3600</defaultValue>
        </textBox>
        <textBox refId="AssetSync_timeout">
          <label>Timeout</label>
          <defaultValue>180</defaultValue>
        </textBox>
        <textBox refId="AssetSync_backend-collect-timeout">
          <label>backend-collect-timeout</label>
          <defaultValue>180</defaultValue>
        </textBox>
        <comboBox refId="AssetSync_debug" noSort="true">
          <label>Debug level</label>
          <default>0</default>
          <suggestion>1</suggestion>
          <suggestion>2</suggestion>
        </comboBox>
        <checkBox refId="AssetSync_no-ssl-check" defaultChecked="false" >no-ssl-check</checkBox>
        <checkBox refId="AssetSync_no-p2p" defaultChecked="false" >no-p2p</checkBox>
        <checkBox refId="AssetSync_scan-homedirs" defaultChecked="false">scan-homedirs</checkBox>
        <checkBox refId="AssetSync_scan-profiles" defaultChecked="false">scan-profiles</checkBox>
        <checkBox refId="AssetSync_no-httpd">no-httpd</checkBox>
        <textBox refId="AssetSync_full-inventory-postpone">
          <label>full-inventory-postpone</label>
          <defaultValue>14</defaultValue>
        </textBox>
        <textBox refId="AssetSync_required-category">
          <label>required-category</label>
          <defaultValue></defaultValue>
        </textBox>
        <textBox refId="AssetSync_itemtype">
          <label>itemtype</label>
          <defaultValue></defaultValue>
        </textBox>
        <checkBox refId="AssetSync_json">json</checkBox>
      </presentation>
    </presentationTable>
  </resources>
</policyDefinitionResources>
